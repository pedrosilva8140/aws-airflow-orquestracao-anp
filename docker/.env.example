# Copie para docker/.env (NUNCA versionar o .env).
# Na EC2, o user_data gera o .env: segredos lidos do SSM e outputs do Terraform/P2.
# Todos os valores abaixo são fictícios.

# Usuário dos containers do Airflow (o padrão da imagem oficial).
AIRFLOW_UID=50000

# Segredos. Gerar com:
#   POSTGRES_PASSWORD / AIRFLOW_JWT_SECRET: openssl rand -hex 32
#   AIRFLOW_FERNET_KEY: python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
POSTGRES_PASSWORD=troque-por-um-valor-aleatorio
AIRFLOW_FERNET_KEY=dHJvcXVlLXBvci11bWEtY2hhdmUtZGUtMzItYnl0ZXM=
AIRFLOW_JWT_SECRET=troque-por-um-valor-aleatorio

# Usuário admin da interface (auth manager FAB), criado pelo airflow-init.
AIRFLOW_ADMIN_USUARIO=admin
AIRFLOW_ADMIN_SENHA=troque-por-uma-senha-forte

# Configuração do DAG (restrições globais do plano).
ANP_BUCKET=bucket-do-p2-exemplo
ANP_TOPICO_ALERTAS_ARN=arn:aws:sns:us-east-2:000000000000:alertas-exemplo
ANP_GLUE_DATABASE=anp_combustiveis
ANP_GLUE_TABELA=precos_gasolina_etanol
ANP_ATHENA_WORKGROUP=workgroup-exemplo
AWS_DEFAULT_REGION=us-east-2
